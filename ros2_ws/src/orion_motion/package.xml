<?xml version="1.0"?>
<package format="3">
  <name>orion_motion</name>
  <version>0.1.0</version>
  <description>Named poses and keyframe motion playback for Orion.</description>

  <maintainer email="ogunbiyioladapo33@gmail.com">mofe</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
