  <!-- Joint from head_roll_link to lamp_head_link -->
  <joint name="head_pitch_joint" type="revolute">
    <origin xyz="1.58207e-15 0.0192 -0.04111" rpy="1.5708 -1.5708 0"/>
    <parent link="head_roll_link"/>
    <child link="lamp_head_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-0.853337" upper="2.28826"/>
  </joint>
  <!-- Joint from forearm_link to head_roll_link -->
  <joint name="head_roll_joint" type="revolute">
    <origin xyz="2.55351e-15 0.185185 0.006125" rpy="1.5708 -0.644947 2.92255e-15"/>
    <parent link="forearm_link"/>
    <child link="head_roll_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-3.78654" upper="2.49665"/>
  </joint>
  <!-- Joint from upper_arm_link to forearm_link -->
  <joint name="elbow_pitch_joint" type="revolute">
    <origin xyz="0.09997366 -0.0312716 0.218327" rpy="1.5708 -1.54809 -0.308645"/>
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <axis xyz="0 0 1"/>
    <limit effort="10" velocity="10" lower="-2.82002" upper="0.321569"/>
  </joint>

  <!-- Standard control interfaces backed by Gazebo simulation. -->
  <ros2_control name="OrionGazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="base_yaw_joint">
      <command_interface name="position">
        <param name="min">-5.02103</param>
        <param name="max">1.26215</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="shoulder_pitch_joint">
      <command_interface name="position">
        <param name="min">-1.30388</param>
        <param name="max">2.05734</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="elbow_pitch_joint">
      <command_interface name="position">
        <param name="min">-2.82002</param>
        <param name="max">0.321569</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="head_roll_joint">
      <command_interface name="position">
        <param name="min">-3.78654</param>
        <param name="max">2.49665</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="head_pitch_joint">
      <command_interface name="position">
        <param name="min">-0.853337</param>
        <param name="max">2.28826</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <!-- Gazebo loads controller_manager and the simulated hardware interface. -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find orion_description)/config/orion_controllers.yaml</parameters>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <child_frame_id>base_footprint</child_frame_id>
      <dimensions>3</dimensions>
      <odom_topic>/orion/base_odometry</odom_topic>
      <odom_publish_frequency>100</odom_publish_frequency>
    </plugin>
  </gazebo>
  <gazebo reference="base_link">
    <sensor name="base_contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/orion/base_contacts</topic>
      <contact>
        <collision>base_footprint_fixed_joint_lump__base_support_collision_collision_10</collision>
      </contact>
    </sensor>
  </gazebo>
</robot>
