[Unit]
Description=Orion onboard voice and agent
Wants=network-online.target
After=network-online.target oriond.service orion-listener.service orion-studio-gateway.service

[Service]
Type=simple
User=@ORION_USER@
WorkingDirectory=@PROJECT_ROOT@
Environment=HOME=@USER_HOME@
Environment=ORION_ONBOARD=1
Environment=ORION_SPEECH_BACKEND=pi
Environment=ORION_PROJECT_ROOT=@PROJECT_ROOT@
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
Environment=TOKENIZERS_PARALLELISM=false
EnvironmentFile=@USER_HOME@/.config/orion/voice-stack.env
ExecStart=@PROJECT_ROOT@/orion-service/target/release/orion-service serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
