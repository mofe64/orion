[Unit]
Description=Orion Studio authenticated gateway
Documentation=file://@PROJECT_ROOT@/orion_studio/README.md
Wants=oriond.service
After=oriond.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@ORION_USER@
WorkingDirectory=@PROJECT_ROOT@
Environment=HOME=@USER_HOME@
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStartPre=@PROJECT_ROOT@/scripts/wait_for_oriond.sh @PROJECT_ROOT@/runtime/target/release/oriond /tmp/oriond.sock 20
ExecStart=/usr/bin/python3 @PROJECT_ROOT@/orion_studio/gateway.py serve --bind 0.0.0.0 --port 7447 --socket /tmp/oriond.sock --token-file @USER_HOME@/.config/orion/studio-token --project-root @PROJECT_ROOT@ --calibration @USER_HOME@/.config/orion/servo_calibration.json --trajectory-compiler @PROJECT_ROOT@/runtime/target/release/orion-trajectory
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
